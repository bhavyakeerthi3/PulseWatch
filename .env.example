# Optional collector overrides. The launcher uses local persistent H2 storage.
COLLECTOR_INTERVAL_MS=30000
COLLECTOR_TIMEOUT_MS=3000
COLLECTOR_RETRIES=1
COLLECTOR_RETRY_DELAY_MS=250
ALERT_LATENCY_THRESHOLD_MS=1500
INCIDENT_AFTER_MINUTES=2
# Optional non-local profile only:
# DATABASE_URL=jdbc:postgresql://localhost:5432/pulsewatch
# DATABASE_USER=pulsewatch
# DATABASE_PASSWORD=configure-outside-git
# REDIS_HOST=localhost
# REDIS_PORT=6379
